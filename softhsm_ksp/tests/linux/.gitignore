# Fetched and built by `make kryoptic` — a second PKCS#11 module to test
# the provider against. Never committed: it is someone else's project, and
# the build is large.
.kryoptic/

# Token database and config created by `make token`.
.token/

# Binaries.
#
# A pattern, not a list of names. The list form was forgotten in sessions
# 8, 9 and 10 — every time a suite was added, its binary showed up
# untracked — so the names are matched and the sources exempted instead.
test_*
!test_*.c
!test_*.h
p11_init_token

# Built by `make openssl` — OpenSSL 3.5, needed because Kryoptic gates
# eddsa on 3.2 and the post-quantum mechanisms on 3.5, and the distribution
# ships 3.0.
.openssl/
.openssl-src/
