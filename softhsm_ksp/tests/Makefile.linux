# Makefile.linux — Linux build with gcov for coverage report
# Usage : make -f Makefile.linux [all | clean | run | coverage]

CC      = gcc
CFLAGS  = -Wall -Wextra -Wno-unused-parameter -Wno-unused-function \
          -g --coverage \
          -I../mock \
          -I../../src \
          -I.

SRC = ../../src
MOCK = ../mock

# Common sources
MEM_SRC  = $(SRC)/common/memory.c
LOG_SRC  = $(SRC)/common/logging.c
PROV_SRC = $(SRC)/ksp/ksp_provider.c
PROP_SRC = $(SRC)/ksp/ksp_properties.c
KEY_SRC  = $(SRC)/ksp/ksp_key.c
CRYPT_SRC= $(SRC)/ksp/ksp_crypto.c
P11U_SRC = $(SRC)/pkcs11/p11_utils.c
CAPS_SRC = $(SRC)/pkcs11/p11_caps.c
MOCK_SRC = $(MOCK)/p11_mock.c

PURE_STUBS = p11_pure_stubs.c
# PIN stub for suites that link ksp_provider.c but not p11_session.c
PIN_STUB   = p11_pin_stub.c

TESTS = \
    test_p11rv_mapping \
    test_function_table \
    test_p11_session \
    test_ecdsa_decode \
    test_mechanism_resolve \
    test_memory \
    test_logging \
    test_export_blobs \
    test_ksp_provider \
    test_ksp_key_props \
    test_ksp_key_ops \
    test_ksp_crypto \
    test_oaep_params \
    test_ecdh \
    test_eddsa \
    test_aes_keys \
    test_mldsa \
    test_certificate \
    test_keywrap \
    test_p11_context \
    test_key_pin \
    test_cert_subject

.PHONY: all clean run coverage syntax-check

all: $(TESTS)

# Every suite depends on every header.
#
# Without this, editing a header rebuilds nothing: the recipes list only .c
# files as prerequisites, so make reports success and leaves a stale binary
# in place. That was found the hard way — a mock buffer was enlarged, the
# suite was re-run, and it failed identically against a binary that had not
# been recompiled. A test build that can silently verify the wrong code is
# worse than one that is slow.
# The recipes therefore compile $(filter %.c,$^), not $^ — adding headers as
# prerequisites otherwise hands them to gcc as translation units.
HEADERS = $(wildcard $(SRC)/*/*.h) $(wildcard $(MOCK)/*.h) test_framework.h
$(TESTS): $(HEADERS) ../Makefile.linux

# ── syntax-check ──────────────────────────────────────────────────────────
# The integration test only *runs* on Windows, but parsing it here catches
# typos before anyone starts a Windows build.
syntax-check:
	@echo "Syntax-checking test_ksp_integration.c (Windows-only test)..."
	@$(CC) -fsyntax-only -I../mock -I../../src -I../../src/ksp \
	    -I../../src/common -I../../src/pkcs11 ../test_ksp_integration.c \
	    && echo "  OK — no syntax errors"

# ── test_p11rv_mapping : P11RvToSecStatus ──────────────────────────────────
test_p11rv_mapping: test_p11rv_mapping.c $(PURE_STUBS) $(P11U_SRC) $(MEM_SRC)
	$(CC) $(CFLAGS) -o $@ $(filter %.c,$^)

# ── test_function_table : ksp_main.c CNG function table ───────────────────
test_function_table: test_function_table.c $(SRC)/ksp/ksp_main.c \
                     $(PROV_SRC) $(PROP_SRC) $(KEY_SRC) $(CRYPT_SRC) \
                     $(P11U_SRC) $(CAPS_SRC) $(MEM_SRC) $(MOCK_SRC)
	$(CC) $(CFLAGS) -o $@ $(filter %.c,$^)

# ── test_p11_session : the PKCS#11 session pool and PIN storage ───────────
test_p11_session: test_p11_session.c $(SRC)/pkcs11/p11_session.c $(MOCK_SRC)
	$(CC) $(CFLAGS) -o $@ $(filter %.c,$^) -lpthread

# ── test_ecdsa_decode : P11_DecodeDerEcdsaSignature, P11_EcCoordSize ───────
test_ecdsa_decode: test_ecdsa_decode.c $(PURE_STUBS) $(P11U_SRC) $(MEM_SRC)
	$(CC) $(CFLAGS) -o $@ $(filter %.c,$^)

# ── test_mechanism_resolve : P11_ResolveMechanism ──────────────────────────
test_mechanism_resolve: test_mechanism_resolve.c $(PURE_STUBS) $(P11U_SRC) $(MEM_SRC)
	$(CC) $(CFLAGS) -o $@ $(filter %.c,$^)

# ── test_memory : KSP_Alloc, KSP_AllocZero, KSP_Free, KSP_WStrDup ──────
test_memory: test_memory.c $(MEM_SRC)
	$(CC) $(CFLAGS) -o $@ $(filter %.c,$^)

# ── test_logging : Log_Initialize, Log_Debug, Log_Error ─────────────────
test_logging: test_logging.c $(LOG_SRC)
	$(CC) $(CFLAGS) -o $@ $(filter %.c,$^)

# ── test_export_blobs : P11_ExportRsaPublicKey, P11_ExportEcPublicKey ────
test_export_blobs: test_export_blobs.c $(P11U_SRC) $(MEM_SRC) $(MOCK_SRC)
	$(CC) $(CFLAGS) -o $@ $(filter %.c,$^)

# ── test_ksp_provider: KSP_OpenProvider, KSP_FreeProvider, properties ───
# ksp_properties.c is not needed here (provider-only test)
test_ksp_provider: test_ksp_provider.c \
    $(PROV_SRC) $(CAPS_SRC) $(MEM_SRC) $(MOCK_SRC)
	$(CC) $(CFLAGS) -o $@ $(filter %.c,$^)

# ── test_ksp_key_props : KSP_GetKeyProperty, KSP_SetKeyProperty ───────────
# ksp_key_stub.c provides KSP_IsValidKey without linking the full ksp_key.c
test_ksp_key_props: test_ksp_key_props.c ksp_key_stub.c \
    $(PROV_SRC) $(PROP_SRC) $(CAPS_SRC) $(MEM_SRC) $(MOCK_SRC) $(PIN_STUB)
	$(CC) $(CFLAGS) -o $@ $(filter %.c,$^)

# ── test_ksp_key_ops : OpenKey, CreatePersistedKey, FinalizeKey, … ────────
test_ksp_key_ops: test_ksp_key_ops.c \
    $(KEY_SRC) $(PROV_SRC) $(CAPS_SRC) $(MEM_SRC) $(MOCK_SRC) $(PIN_STUB)
	$(CC) $(CFLAGS) -o $@ $(filter %.c,$^)

# ── test_ksp_crypto : SignHash, Decrypt, ExportKey, ImportKey ─────────────
#
# KEY_SRC is here for the curve-family predicates KSP_ExportKey uses to send
# Edwards and Montgomery keys to the raw-point exporter rather than the
# X9.62 one.
test_ksp_crypto: test_ksp_crypto.c \
    $(CRYPT_SRC) $(KEY_SRC) $(PROV_SRC) $(P11U_SRC) $(CAPS_SRC) $(MEM_SRC) \
    $(MOCK_SRC) $(PIN_STUB)
	$(CC) $(CFLAGS) -o $@ $(filter %.c,$^) -lpthread

# ── test_oaep_params : P11_MapHashAlg, P11_BuildOaepParams (Phase 2) ──────
test_oaep_params: test_oaep_params.c $(PURE_STUBS) $(P11U_SRC) $(MEM_SRC)
	$(CC) $(CFLAGS) -o $@ $(filter %.c,$^)

# ── test_ecdh : SecretAgreement, DeriveKey, FreeSecret (Phase 4) ──────────
test_ecdh: test_ecdh.c \
    $(CRYPT_SRC) $(KEY_SRC) $(PROV_SRC) $(P11U_SRC) $(CAPS_SRC) $(MEM_SRC) \
    $(LOG_SRC) $(MOCK_SRC) $(PIN_STUB)
	$(CC) $(CFLAGS) -o $@ $(filter %.c,$^) -lpthread

# ── test_eddsa : Ed25519 / Ed448 keygen, sign, export (Phase 5) ───────────
test_eddsa: test_eddsa.c \
    $(KEY_SRC) $(CRYPT_SRC) $(PROV_SRC) $(P11U_SRC) $(CAPS_SRC) $(MEM_SRC) $(LOG_SRC) \
    $(MOCK_SRC) $(PIN_STUB)
	$(CC) $(CFLAGS) -o $@ $(filter %.c,$^) -lpthread

# ── test_aes_keys : AES keygen, Encrypt/Decrypt, HMAC (Phase 6) ───────────
test_aes_keys: test_aes_keys.c \
    $(KEY_SRC) $(CRYPT_SRC) $(PROV_SRC) $(PROP_SRC) $(P11U_SRC) \
    $(CAPS_SRC) $(MEM_SRC) $(LOG_SRC) $(MOCK_SRC) $(PIN_STUB)
	$(CC) $(CFLAGS) -o $@ $(filter %.c,$^) -lpthread

# ── test_mldsa : capability probe + post-quantum gating (Phase 4) ─────────
test_mldsa: test_mldsa.c \
    $(KEY_SRC) $(CRYPT_SRC) $(PROV_SRC) $(PROP_SRC) $(P11U_SRC) $(CAPS_SRC) \
    $(MEM_SRC) $(LOG_SRC) $(MOCK_SRC) $(PIN_STUB)
	$(CC) $(CFLAGS) -o $@ $(filter %.c,$^) -lpthread

# ── test_certificate : NCRYPT_CERTIFICATE_PROPERTY (PROP-14) ──────────────
test_certificate: test_certificate.c \
    $(KEY_SRC) $(PROV_SRC) $(PROP_SRC) $(P11U_SRC) $(CAPS_SRC) \
    $(MEM_SRC) $(LOG_SRC) $(MOCK_SRC) $(PIN_STUB)
	$(CC) $(CFLAGS) -o $@ $(filter %.c,$^) -lpthread

# ── test_keywrap : AES key wrap / unwrap (AES-09) ─────────────────────────
test_keywrap: test_keywrap.c \
    $(KEY_SRC) $(CRYPT_SRC) $(PROV_SRC) $(PROP_SRC) $(P11U_SRC) $(CAPS_SRC) \
    $(MEM_SRC) $(LOG_SRC) $(MOCK_SRC) $(PIN_STUB)
	$(CC) $(CFLAGS) -o $@ $(filter %.c,$^) -lpthread

# ── test_p11_context : module load, init retry, slot selection (OPS-08) ───
test_p11_context: test_p11_context.c \
    $(SRC)/pkcs11/p11_context.c $(P11U_SRC) $(CAPS_SRC) \
    $(MEM_SRC) $(LOG_SRC) $(MOCK_SRC)
	$(CC) $(CFLAGS) -o $@ $(filter %.c,$^) -lpthread

# ── test_key_pin : per-key PIN via CKU_CONTEXT_SPECIFIC (PROP-13) ─────────
test_key_pin: test_key_pin.c \
    $(KEY_SRC) $(CRYPT_SRC) $(PROP_SRC) $(PROV_SRC) $(P11U_SRC) $(CAPS_SRC) \
    $(MEM_SRC) $(LOG_SRC) $(MOCK_SRC) $(PIN_STUB)
	$(CC) $(CFLAGS) -o $@ $(filter %.c,$^) -lpthread

# ── test_cert_subject : X.509 subject extraction for CKA_SUBJECT ──────────
test_cert_subject: test_cert_subject.c $(PURE_STUBS) $(P11U_SRC) $(MEM_SRC)
	$(CC) $(CFLAGS) -o $@ $(filter %.c,$^)

run: all
	@echo "════════════════════════════════════════════════════════"
	@echo " Running unit tests"
	@echo "════════════════════════════════════════════════════════"
	@PASS=0; FAIL=0; \
	for t in $(TESTS); do \
	    echo ""; echo "▶ $$t"; \
	    if ./$$t; then \
	        PASS=$$((PASS+1)); \
	    else \
	        FAIL=$$((FAIL+1)); echo "[ERROR] $$t failed"; \
	    fi; \
	done; \
	echo ""; \
	echo "════════════════════════════════════════════════════════"; \
	echo "  Results: PASS=$$PASS  FAIL=$$FAIL"; \
	echo "════════════════════════════════════════════════════════"; \
	test $$FAIL -eq 0

coverage: run
	@echo ""
	@echo "══ Generating coverage report (lcov + genhtml) ══"
	lcov --capture \
	     --directory . \
	     --output-file coverage.info \
	     --ignore-errors gcov,empty
	lcov --remove coverage.info \
	     '*/tests/*' \
	     '*/mock/*' \
	     --output-file coverage_filtered.info \
	     --ignore-errors unused,empty
	genhtml coverage_filtered.info \
	     --output-directory coverage_html \
	     --title "SoftHSM KSP — Coverage report" \
	     --legend \
	     --show-details
	@echo ""
	@echo "══ Coverage summary ══"
	lcov --summary coverage_filtered.info
	@echo ""
	@echo "HTML report available at: tests/unit/coverage_html/index.html"

clean:
	rm -f $(TESTS)
	rm -f *.gcno *.gcda
	rm -f ../../src/ksp/*.gcno    ../../src/ksp/*.gcda
	rm -f ../../src/pkcs11/*.gcno ../../src/pkcs11/*.gcda
	rm -f ../../src/common/*.gcno ../../src/common/*.gcda
	rm -f ../mock/*.gcno          ../mock/*.gcda
	rm -f coverage.info coverage_filtered.info
	rm -rf coverage_html
