# Database
DATABASE_URL=postgresql+asyncpg://kms:kms_secret@localhost:5432/kms

# Security
SECRET_KEY=change-me-to-a-random-256-bit-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PKCS#11 / SoftHSM2
PKCS11_LIB=/usr/lib/softhsm/libsofthsm2.so
PKCS11_TOKEN_LABEL=kms-master
PKCS11_PIN=1234

# Server
API_HOST=0.0.0.0
API_PORT=8000
KMIP_HOST=0.0.0.0
KMIP_PORT=5696

# TLS (for KMIP server)
TLS_CERT_FILE=certs/server.crt
TLS_KEY_FILE=certs/server.key
TLS_CA_FILE=certs/ca.crt

# Admin bootstrap user
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-run

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
